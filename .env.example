# Copy this file to ".env" and fill in the keys you have. Never share or commit .env.
# You need at least ONE provider key. With none, the app runs in offline demo mode.

# --- API keys (keep secret) ---
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Text models (verify current names in each provider's dashboard) ---
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
RESOURCE_AI_PRIMARY_PROVIDER=groq

# --- Vision (photo analysis). A provider is used for images ONLY if it has a vision model here. ---
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_VISION_MODEL=gemini-3.8-flash
# OPENROUTER_VISION_MODEL=   (leave unset unless you pick a model that accepts images)
RESOURCE_AI_VISION_ORDER=groq,gemini,openrouter
RESOURCE_AI_MAX_IMAGE_MB=5

# --- Optional ---
# RESOURCE_AI_MOCK=auto        (1/true/always = force offline, 0/false/never = force cloud)
# RESOURCE_AI_CURRENCY=INR